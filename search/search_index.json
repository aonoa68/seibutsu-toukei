30bf\u306e\u8981\u7d04 \u52d5\u753b\u30fb\u30b9\u30e9\u30a4\u30c9\u30fb\u914d\u5e03\u8cc7\u6599\u30fb\u30c7\u30fc\u30bf\u30fb\u8ab2\u984c\u30fb\u89e3\u7b54\u4f8b \u7b2c5\u56de \u96e2\u6563\u578b\u78ba\u7387\u5909\u6570 \u52d5\u753b\u30fb\u30b9\u30e9\u30a4\u30c9\u30fb\u914d\u5e03\u8cc7\u6599 \u7b2c6\u56de \u9023\u7d9a\u578b\u78ba\u7387\u5909\u6570 \u52d5\u753b\u30fb\u30b9\u30e9\u30a4\u30c9\u30fb\u914d\u5e03\u8cc7\u6599 \u7b2c7\u56de \u6bcd\u96c6\u56e3\u3068\u6a19\u672c \u52d5\u753b\u30fb\u30b9\u30e9\u30a4\u30c9\u30fb\u914d\u5e03\u8cc7\u6599\u30fb\u8ab2\u984c\u30fb\u89e3\u7b54\u4f8b \u7b2c8\u56de \u63a8\u5b9a\u306e\u57fa\u790e \u52d5\u753b\u30fb\u30b9\u30e9\u30a4\u30c9\u30fb\u914d\u5e03\u8cc7\u6599 \u7b2c9\u56de \u4eee\u8aac\u691c\u5b9a\u306e\u8003\u3048\u65b9 \u52d5\u753b\u30fb\u30b9\u30e9\u30a4\u30c9\u30fb\u914d\u5e03\u8cc7\u6599 \u7b2c10\u56de \u9069\u5408\u5ea6\u3068\u72ec\u7acb\u6027\u306e\u691c\u5b9a \u52d5\u753b\u30fb\u30b9\u30e9\u30a4\u30c9\u30fb\u914d\u5e03\u8cc7\u6599\u30fb\u30b3\u30fc\u30c9\u30fb\u8ab2\u984c\u30fb\u89e3\u7b54\u4f8b \u7b2c11\u56de \u5206\u6563\u5206\u6790\u2460 \u52d5\u753b\u30fb\u30b9\u30e9\u30a4\u30c9\u30fb\u914d\u5e03\u8cc7\u6599 \u7b2c12\u56de \u5206\u6563\u5206\u6790\u2461 \u52d5\u753b\u30fb\u30b9\u30e9\u30a4\u30c9\u30fb\u914d\u5e03\u8cc7\u6599\u30fb\u30b3\u30fc\u30c9 \u7b2c13\u56de \u4e3b\u6210\u5206\u5206\u6790 \u52d5\u753b\u30fb\u30b9\u30e9\u30a4\u30c9\u30fb\u914d\u5e03\u8cc7\u6599\u30fb\u30b3\u30fc\u30c9 \u7b2c14\u56de \u6700\u5c24\u6cd5\uff08\u5bfe\u9762\uff09 \u30b9\u30e9\u30a4\u30c9\u30fb\u8ab2\u984c\u30fb\u89e3\u7b54\u4f8b <p>\u8cc7\u6599\u306e\u8457\u4f5c\u6a29\u306f\u4f5c\u6210\u8005\uff08\u5c0f\u91ce\u539f \u5f69\u9999\uff09\u306b\u3042\u308a\u307e\u3059\u3002\u8cc7\u6599\u4e2d\u306b\u5f15\u7528\u3057\u305f\u56f3\u8868\u30fb\u7d71\u8a08\u306e\u6a29\u5229\u306f\u3001\u305d\u308c\u305e\u308c\u306e\u51fa\u5178\u5143\u306b\u5e30\u5c5e\u3057\u307e\u3059\u3002\u73fe\u5728\u306e\u62c5\u5f53\u6388\u696d\u306f Teaching \u30da\u30fc\u3